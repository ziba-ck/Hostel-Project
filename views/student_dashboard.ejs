<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f6f9; padding: 20px; margin: 0; }
        .card { background: white; padding: 25px; border-radius: 10px; max-width: 500px; margin: 30px auto; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        h2 { color: #4a40d4; margin-top: 0; }
        .info { margin: 10px 0; font-size: 1.05em; }
        .btn-logout { display: inline-block; margin-top: 20px; padding: 10px 18px; background: #d9534f; color: white; border-radius: 6px; text-decoration: none; font-weight: bold; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Welcome, <%= user.name %>! 👋</h2>
        <p class="info"><strong>Email:</strong> <%= user.email %></p>
        <p class="info"><strong>Course:</strong> <%= user.course || 'N/A' %></p>
        <p class="info"><strong>Contact:</strong> <%= user.contact || 'N/A' %></p>
        <p class="info"><strong>ID Card / Ver. No:</strong> <%= user.id_card || 'N/A' %></p>
        <p class="info"><strong>Diet Preference:</strong> <%= user.diet || 'N/A' %></p>
        
        <a href="/logout" class="btn-logout">Logout</a>
    </div>
</body>
</html>