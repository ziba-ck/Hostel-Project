<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HostelHub - Student Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        :root {
            --bg-space: #030712;
            --purple-glow: #6366f1;
            --blue-gradient: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
            --card-glass: rgba(15, 23, 42, 0.7);
            --border-glass: rgba(255, 255, 255, 0.08);
            --text-main: #f8fafc;
            --text-sub: #94a3b8;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }

        body {
            background-color: var(--bg-space);
            background-image: 
                radial-gradient(circle at 15% 15%, rgba(99, 102, 241, 0.18) 0%, transparent 50%),
                radial-gradient(circle at 85% 85%, rgba(168, 85, 247, 0.15) 0%, transparent 50%);
            color: var(--text-main);
            padding: 30px 20px;
            min-height: 100vh;
        }

        .container { max-width: 1100px; margin: 0 auto; }

        /* Header */
        .header {
            background: var(--card-glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            padding: 20px 28px;
            border-radius: 20px;
            border: 1px solid var(--border-glass);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        .header h1 {
            font-size: 1.5rem;
            font-weight: 800;
            background: var(--blue-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header p { font-size: 0.85rem; color: var(--text-sub); margin-top: 2px; }

        .btn-logout {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            padding: 10px 22px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.85rem;
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
            transition: all 0.2s;
        }
        .btn-logout:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(239, 68, 68, 0.5); }

        /* AI Banner */
        .glass-ai-banner {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 24px;
            padding: 24px 32px;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
            position: relative;
            overflow: hidden;
        }

        .ai-content h2 {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 8px;
            background: linear-gradient(135deg, #c084fc, #38bdf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .ai-content p { font-size: 0.9rem; color: var(--text-sub); max-width: 480px; line-height: 1.6; }

        .ai-orb-wrapper {
            position: relative;
            width: 140px;
            height: 140px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
        }

        #glass-ai-canvas {
            width: 140px;
            height: 140px;
            filter: drop-shadow(0 0 25px rgba(56, 189, 248, 0.5));
        }

        /* Cards Grid */
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 22px; }

        .card {
            background: var(--card-glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 20px;
            padding: 24px;
            border: 1px solid var(--border-glass);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.2s;
        }
        .card:hover { transform: translateY(-3px); border-color: rgba(129, 140, 248, 0.3); }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-glass);
            padding-bottom: 12px;
            margin-bottom: 16px;
        }

        .card-header h3 { font-size: 1.05rem; font-weight: 700; color: #a5b4fc; }

        .badge {
            font-size: 0.75rem;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .badge-success { background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
        .badge-warning { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }

        .info-row { display: flex; justify-content: space-between; font-size: 0.9rem; margin-bottom: 12px; }
        .info-label { color: var(--text-sub); }
        .info-val { color: var(--text-main); font-weight: 600; }

        form { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }

        select, textarea, input {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border-glass);
            border-radius: 12px;
            font-size: 0.85rem;
            background: rgba(3, 7, 18, 0.7);
            color: #fff;
            outline: none;
            transition: all 0.2s;
        }
        select:focus, textarea:focus { border-color: #818cf8; box-shadow: 0 0 10px rgba(99, 102, 241, 0.3); }

        .btn-action {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(99, 102, 241, 0.3);
            transition: all 0.2s;
        }
        .btn-action:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5); }

        .log-list { margin-top: 12px; border-top: 1px dashed var(--border-glass); padding-top: 10px; }
        .log-item { font-size: 0.8rem; color: var(--text-sub); padding: 5px 0; display: flex; justify-content: space-between; }
    </style>
</head>
<body>

    <div class="container">
        <!-- Header -->
        <div class="header">
            <div>
                <h1>Welcome, <%= user.name %>! 👋</h1>
                <p>HostelHub Space Management System</p>
            </div>
            <a href="/logout" class="btn-logout">Logout</a>
        </div>

        <!-- 3D AI Banner -->
        <div class="glass-ai-banner">
            <div class="ai-content">
                <h2>AI Assistant & Smart Operations</h2>
                <p>Click the 3D Orbiting Sphere to check real-time hostel verification, mess schedules, and automated balance checks.</p>
            </div>
            <div class="ai-orb-wrapper" id="ai-orb-btn">
                <canvas id="glass-ai-canvas"></canvas>
            </div>
        </div>

        <!-- 6 Core Feature Grid -->
        <div class="grid">

            <!-- 1. Student Profile -->
            <div class="card">
                <div>
                    <div class="card-header"><h3>1. Student Profile</h3></div>
                    <div class="info-row"><span class="info-label">Email</span><span class="info-val"><%= user.email %></span></div>
                    <div class="info-row"><span class="info-label">Course</span><span class="info-val"><%= user.course || 'B.Tech CSE' %></span></div>
                    <div class="info-row"><span class="info-label">Contact</span><span class="info-val"><%= user.contact || 'N/A' %></span></div>
                    <div class="info-row"><span class="info-label">ID Verification</span><span class="info-val"><%= user.id_card || 'Verified' %></span></div>
                </div>
            </div>

            <!-- 2. Room Allocation -->
            <div class="card">
                <div>
                    <div class="card-header">
                        <h3>2. Room Allocation</h3>
                        <span class="badge badge-success"><%= room.status %></span>
                    </div>
                    <div class="info-row"><span class="info-label">Block / Wing</span><span class="info-val"><%= room.block %></span></div>
                    <div class="info-row"><span class="info-label">Room Number</span><span class="info-val"><%= room.room_number %></span></div>
                </div>
            </div>

            <!-- 3. Fee Management -->
            <div class="card">
                <div>
                    <div class="card-header">
                        <h3>3. Fee Management</h3>
                        <span class="badge badge-warning"><%= fee.status %></span>
                    </div>
                    <div class="info-row"><span class="info-label">Hostel Fee</span><span class="info-val">₹<%= fee.amount %></span></div>
                    <div class="info-row"><span class="info-label">Due Date</span><span class="info-val"><%= fee.due_date %></span></div>
                </div>
            </div>

            <!-- 4. Food & Menu Management -->
            <div class="card">
                <div>
                    <div class="card-header"><h3>4. Food & Menu</h3></div>
                    <div class="info-row"><span class="info-label">Diet Choice</span><span class="info-val"><%= user.diet || 'Vegetarian' %></span></div>
                    <div class="info-row"><span class="info-label">Breakfast</span><span class="info-val"><%= menu.breakfast %></span></div>
                    <div class="info-row"><span class="info-label">Lunch</span><span class="info-val"><%= menu.lunch %></span></div>
                    <div class="info-row"><span class="info-label">Dinner</span><span class="info-val"><%= menu.dinner %></span></div>
                </div>
            </div>

            <!-- 5. Complaints & Requests -->
            <div class="card">
                <div>
                    <div class="card-header"><h3>5. Complaints & Requests</h3></div>
                    <form action="/complaint" method="POST">
                        <select name="category" required>
                            <option value="Maintenance">Maintenance / Repair</option>
                            <option value="Cleanliness">Room Cleanliness</option>
                            <option value="Network">WiFi & Network</option>
                        </select>
                        <textarea name="description" rows="2" placeholder="Describe issue or request..." required></textarea>
                        <button type="submit" class="btn-action">Submit Request</button>
                    </form>
                </div>
                <% if (complaints && complaints.length > 0) { %>
                    <div class="log-list">
                        <% complaints.forEach(item => { %>
                            <div class="log-item">
                                <span><strong><%= item.category %>:</strong> <%= item.description %></span>
                                <span class="badge badge-warning"><%= item.status %></span>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <!-- 6. Check-In / Check-Out Operations -->
            <div class="card">
                <div>
                    <div class="card-header"><h3>6. Check-In / Out Operations</h3></div>
                    <form action="/check-log" method="POST">
                        <select name="action">
                            <option value="Check-In">Check-In</option>
                            <option value="Check-Out">Check-Out</option>
                        </select>
                        <button type="submit" class="btn-action">Record Action</button>
                    </form>
                </div>
                <div class="log-list">
                    <% if (logs && logs.length > 0) { %>
                        <% logs.forEach(log => { %>
                            <div class="log-item">
                                <span><%= log.action %></span>
                                <span><%= log.timestamp %></span>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>

        </div>
    </div>

    <!-- 3D Orbiting Sphere Script -->
    <script>
        const canvas = document.getElementById('glass-ai-canvas');
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 1000);
        camera.position.z = 4.0;

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setSize(140, 140);
        renderer.setPixelRatio(window.devicePixelRatio);

        // Earth Central Sphere
        const earthGeo = new THREE.SphereGeometry(0.85, 32, 32);
        const earthMat = new THREE.MeshPhongMaterial({ color: 0x38bdf8, emissive: 0x0284c7, specular: 0xbae6fd, shininess: 90 });
        const earthMesh = new THREE.Mesh(earthGeo, earthMat);
        scene.add(earthMesh);

        // Outer Glass Shell
        const glassGeo = new THREE.SphereGeometry(1.05, 32, 32);
        const glassMat = new THREE.MeshPhysicalMaterial({ color: 0x818cf8, transparent: true, opacity: 0.3, transmission: 0.85 });
        const glassShell = new THREE.Mesh(glassGeo, glassMat);
        scene.add(glassShell);

        // Orbit Ring
        const orbitRadius = 1.6;
        const ringGeo = new THREE.RingGeometry(orbitRadius - 0.015, orbitRadius + 0.015, 64);
        const ringMat = new THREE.MeshBasicMaterial({ color: 0x38bdf8, side: THREE.DoubleSide, transparent: true, opacity: 0.35 });
        const orbitRing = new THREE.Mesh(ringGeo, ringMat);
        orbitRing.rotation.x = Math.PI / 2.3;
        scene.add(orbitRing);

        // Orbiting Moon
        const moonGeo = new THREE.SphereGeometry(0.2, 24, 24);
        const moonMat = new THREE.MeshStandardMaterial({ color: 0xc084fc, emissive: 0x9333ea, roughness: 0.3 });
        const moonMesh = new THREE.Mesh(moonGeo, moonMat);
        scene.add(moonMesh);

        // Lighting
        const pointLight = new THREE.PointLight(0x38bdf8, 3, 10);
        pointLight.position.set(2, 3, 4);
        scene.add(pointLight);
        scene.add(new THREE.AmbientLight(0xffffff, 0.6));

        // Animation Loop
        let angle = 0;
        function animate() {
            requestAnimationFrame(animate);
            earthMesh.rotation.y += 0.01;
            glassShell.rotation.y -= 0.005;

            angle += 0.03;
            const tilt = Math.PI / 2.3;
            moonMesh.position.x = Math.cos(angle) * orbitRadius;
            moonMesh.position.y = Math.sin(angle) * orbitRadius * Math.sin(tilt);
            moonMesh.position.z = Math.sin(angle) * orbitRadius * Math.cos(tilt);

            renderer.render(scene, camera);
        }
        animate();

        document.getElementById('ai-orb-btn').addEventListener('click', () => {
            alert("🤖 HostelHub AI Assistant Activated!\nStatus: Room Allocated (Block A, Room 204)\nMess Bill: Pending (Due 2026-11-01)");
        });
    </script>
</body>
</html>