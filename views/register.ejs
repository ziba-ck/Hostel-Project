<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registration Error</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f4f6f9; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .card { background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); text-align: center; max-width: 350px; }
        .error { color: #d9534f; font-weight: bold; margin-bottom: 15px; }
        a { color: #4a40d4; text-decoration: none; font-weight: bold; }
    </style>
</head>
<body>
    <div class="card">
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>
        <p><a href="/">Back to Login & Registration</a></p>
    </div>
</body>
</html>