<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HostelHub - AI Management System</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <style>
        :root {
            --bg-space: #030712;
            --purple-glow: #6366f1;
            --blue-gradient: linear-gradient(135deg, #38bdf8, #818cf8, #c084fc);
            --card-glass: rgba(15, 23, 42, 0.75);
            --border-glass: rgba(255, 255, 255, 0.1);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }

        body {
            background-color: var(--bg-space);
            background-image: 
                radial-gradient(circle at 50% 25%, rgba(99, 102, 241, 0.22) 0%, transparent 60%),
                radial-gradient(circle at 50% 80%, rgba(168, 85, 247, 0.15) 0%, transparent 50%);
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
            overflow-x: hidden;
        }

        .space-container {
            width: 100%;
            max-width: 520px;
            text-align: center;
            position: relative;
            z-index: 2;
        }

        /* 3D Canvas Container */
        .glass-badge-wrapper {
            position: relative;
            width: 220px;
            height: 220px;
            margin: 0 auto 10px auto;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        #glass-h-canvas {
            width: 220px;
            height: 220px;
            filter: drop-shadow(0 0 30px rgba(56, 189, 248, 0.5));
        }

        .badge-tag {
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 2px;
            color: #38bdf8;
            text-transform: uppercase;
            margin-bottom: 12px;
            display: inline-block;
        }

        h1 {
            font-size: 2.8rem;
            font-weight: 800;
            margin-bottom: 12px;
            letter-spacing: -1px;
        }

        h1 .highlight {
            background: var(--blue-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            font-size: 1rem;
            color: #94a3b8;
            max-width: 440px;
            margin: 0 auto 30px auto;
            line-height: 1.6;
            font-weight: 400;
        }

        /* Glass Form Cards */
        .glass-card {
            background: var(--card-glass);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-glass);
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            text-align: left;
            margin-bottom: 20px;
        }

        .form-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 18px;
            text-align: center;
        }

        .input-group { margin-bottom: 14px; }

        input, select {
            width: 100%;
            padding: 12px 16px;
            background: rgba(3, 7, 18, 0.6);
            border: 1px solid var(--border-glass);
            border-radius: 12px;
            color: #fff;
            font-size: 0.95rem;
            outline: none;
            transition: all 0.2s;
        }

        input:focus, select:focus {
            border-color: #818cf8;
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.3);
        }

        .btn-enter {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            border: none;
            color: white;
            border-radius: 12px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
            transition: all 0.2s;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
        }

        .btn-enter:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(99, 102, 241, 0.6);
        }

        .footer-tag { font-size: 0.85rem; color: #64748b; margin-top: 20px; }
        .error-msg { color: #f87171; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.3); padding: 10px; border-radius: 10px; font-size: 0.85rem; margin-bottom: 15px; text-align: center; }
        .success-msg { color: #4ade80; background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.3); padding: 10px; border-radius: 10px; font-size: 0.85rem; margin-bottom: 15px; text-align: center; }
    </style>
</head>
<body>

    <div class="space-container">
        <!-- 3D Earth & Orbiting Moon Canvas -->
        <div class="glass-badge-wrapper">
            <canvas id="glass-h-canvas"></canvas>
        </div>

        <div class="badge-tag">✦ AI HOSTEL MANAGEMENT MADE SIMPLE</div>
        <h1>Welcome to <span class="highlight">HostelHub</span></h1>
        <p class="subtitle">Your simple, friendly space to manage rooms, fees, food, complaints and student services.</p>

        <% if (locals.error && error) { %>
            <div class="error-msg"><%= error %></div>
        <% } %>

        <% if (locals.success && success) { %>
            <div class="success-msg"><%= success %></div>
        <% } %>

        <!-- Login Form -->
        <div class="glass-card">
            <div class="form-title">Enter HostelHub</div>
            <form action="/login" method="POST">
                <div class="input-group">
                    <input type="email" name="email" placeholder="Email Address" required>
                </div>
                <div class="input-group">
                    <input type="password" name="password" placeholder="Password" required>
                </div>
                <button type="submit" class="btn-enter">Enter HostelHub →</button>
            </form>
        </div>

        <!-- Registration Form -->
        <div class="glass-card">
            <div class="form-title">Student Registration</div>
            <form action="/register" method="POST">
                <input type="hidden" name="role" value="student">
                <div class="input-group">
                    <input type="text" name="name" placeholder="Full Name" required>
                </div>
                <div class="input-group">
                    <input type="email" name="email" placeholder="Email" required>
                </div>
                <div class="input-group">
                    <input type="password" name="password" placeholder="Password" required>
                </div>
                <div class="input-group">
                    <select name="gender" required>
                        <option value="" disabled selected>Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="input-group">
                    <input type="text" name="course" placeholder="Course (e.g. B.Tech CSE)" required>
                </div>
                <div class="input-group">
                    <input type="tel" name="contact" placeholder="Contact Number" required>
                </div>
                <div class="input-group">
                    <input type="text" name="id_card" placeholder="ID Card / Verification No." required>
                </div>
                <div class="input-group">
                    <select name="diet" required>
                        <option value="Vegetarian">Vegetarian</option>
                        <option value="Non-Vegetarian">Non-Vegetarian</option>
                    </select>
                </div>
                <button type="submit" class="btn-enter">Create Student Account</button>
            </form>
        </div>

        <div class="footer-tag">Secure • Simple • Student-friendly</div>
    </div>

    <!-- Three.js Orbiting System Script -->
    <script>
        const canvas = document.getElementById('glass-h-canvas');
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 1000);
        camera.position.z = 4.2;

        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setSize(220, 220);
        renderer.setPixelRatio(window.devicePixelRatio);

        // 1. Central Glowing Earth Sphere
        const earthGeo = new THREE.SphereGeometry(0.85, 32, 32);
        const earthMat = new THREE.MeshPhongMaterial({
            color: 0x38bdf8,
            emissive: 0x0284c7,
            specular: 0xbae6fd,
            shininess: 90
        });
        const earthMesh = new THREE.Mesh(earthGeo, earthMat);
        scene.add(earthMesh);

        // 2. Glass Atmosphere Shell
        const glassGeo = new THREE.SphereGeometry(1.05, 32, 32);
        const glassMat = new THREE.MeshPhysicalMaterial({
            color: 0x818cf8,
            transparent: true,
            opacity: 0.3,
            roughness: 0.1,
            metalness: 0.1,
            transmission: 0.85
        });
        const glassShell = new THREE.Mesh(glassGeo, glassMat);
        scene.add(glassShell);

        // 3. Circular Orbit Ring Line
        const orbitRadius = 1.7;
        const ringGeo = new THREE.RingGeometry(orbitRadius - 0.015, orbitRadius + 0.015, 64);
        const ringMat = new THREE.MeshBasicMaterial({
            color: 0x38bdf8,
            side: THREE.DoubleSide,
            transparent: true,
            opacity: 0.35
        });
        const orbitRing = new THREE.Mesh(ringGeo, ringMat);
        orbitRing.rotation.x = Math.PI / 2.3; // Tilt orbit line
        scene.add(orbitRing);

        // 4. Orbiting Moon Sphere
        const moonGeo = new THREE.SphereGeometry(0.2, 24, 24);
        const moonMat = new THREE.MeshStandardMaterial({
            color: 0xc084fc,
            emissive: 0x9333ea,
            roughness: 0.3
        });
        const moonMesh = new THREE.Mesh(moonGeo, moonMat);
        scene.add(moonMesh);

        // Lighting
        const pointLight = new THREE.PointLight(0x38bdf8, 3, 10);
        pointLight.position.set(2, 3, 4);
        scene.add(pointLight);

        const purpleLight = new THREE.PointLight(0xc084fc, 2, 8);
        purpleLight.position.set(-2, -2, 2);
        scene.add(purpleLight);

        scene.add(new THREE.AmbientLight(0xffffff, 0.6));

        // Animation Loop (Circling Orbit)
        let angle = 0;
        function animate() {
            requestAnimationFrame(animate);

            // Self-rotation of Earth
            earthMesh.rotation.y += 0.01;
            glassShell.rotation.y -= 0.005;

            // Calculate Circular Orbit position
            angle += 0.03;
            const tilt = Math.PI / 2.3;
            moonMesh.position.x = Math.cos(angle) * orbitRadius;
            moonMesh.position.y = Math.sin(angle) * orbitRadius * Math.sin(tilt);
            moonMesh.position.z = Math.sin(angle) * orbitRadius * Math.cos(tilt);

            renderer.render(scene, camera);
        }
        animate();
    </script>
</body>
</html>